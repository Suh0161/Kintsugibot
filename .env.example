# ── LLM Provider ────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works (DeepSeek, OpenAI, Groq, Ollama, etc.)
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ── GitHub App ───────────────────────────────────────────────────────────────
# Create at: github.com/settings/apps (personal) or org Settings → GitHub Apps
#
# App ID: App settings page → "About" → numeric App ID
GITHUB_APP_ID=

# Private key: download the .pem from GitHub and set the path (recommended)
GITHUB_APP_PRIVATE_KEY_PATH=your-app.private-key.pem

# Or paste inline (replace real newlines with \n):
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# Webhook secret: you choose this when creating the App — must match exactly
WEBHOOK_SECRET=

# ── Redis (BullMQ job queue) ─────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── HTTP Server ──────────────────────────────────────────────────────────────
PORT=3000

# ── Worker ───────────────────────────────────────────────────────────────────
# both | api | worker  (split API and worker for production)
RUN_MODE=both

# Number of issues processed in parallel (increase for busier repos)
WORKER_CONCURRENCY=2

# ── Bot Identity (optional branding) ────────────────────────────────────────
# Name shown in GitHub comments and PR signatures
# BOT_NAME=KintsugiBot

# Git author email used when committing fixes
# BOT_GIT_EMAIL=kintsugibot@users.noreply.github.com

# Branch name prefix  →  e.g. kintsugi/fix-issue-42
# BOT_BRANCH_PREFIX=kintsugi

# ── Sandbox (E2B cloud execution) ───────────────────────────────────────────
# Get your API key at e2b.dev — free tier available
E2B_API_KEY=

# ── Billing (GitHub Marketplace) ────────────────────────────────────────────
# Free tier limit: issues processed per installation per month
# Override if you want a different free tier before Marketplace listing
# BILLING_FREE_LIMIT=10

# ── Logging ─────────────────────────────────────────────────────────────────
# LOG_LEVEL=info   # debug | info | warn | error

# ── Local Development ────────────────────────────────────────────────────────
# Smee channel for forwarding GitHub webhooks to localhost
# SMEE_URL=https://smee.io/your-channel-id

# Skip webhook signature verification (NEVER enable on a public URL)
# DEV_SKIP_WEBHOOK_SIGNATURE_VERIFY=1
