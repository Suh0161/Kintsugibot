{
  "name": "issuebot",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous GitHub Issue → investigation → PR bot",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:infra": "tsx scripts/test-infra.ts",
    "smee": "tsx scripts/smee.ts"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.1.5",
    "@octokit/rest": "^21.0.2",
    "@octokit/webhooks": "^13.4.1",
    "bullmq": "^5.34.10",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "openai": "^4.77.0",
    "pino": "^9.6.0",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "smee-client": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
